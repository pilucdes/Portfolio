---
import '../styles/global.css';

import {getLangFromUrl} from "../scripts/services/i18nService";
const lang = getLangFromUrl(Astro.url);

---

<html lang={lang}>
<head>
    <meta charset="utf-8"/>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
    <meta name="viewport" content="width=device-width"/>
    <meta name="generator" content={Astro.generator}/>
    <meta name="description" content="Pierre-luc portfolio website"/>
    <title>Pierre-luc Deschesnes</title>
</head>

<body>
    <main class="bg-gradient">
        <slot/>
    </main>
</body>

<script src="../scripts/app.ts"></script>

</html>
