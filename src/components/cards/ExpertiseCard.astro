---
interface Props {
    title: string;
    class?: string
}

const {title, class: className} = Astro.props;
---
<div class:list={["p-6 rounded-lg shadow-sm dark:bg-gray-800 fade-in", className]}>
    <h5 class="mb-2 text-xl lg:text-3xl font-bold tracking-tight text-white text-center fade-in">
        {title}
    </h5>
    <ul class="text-left text-md lg:text-2xl space-y-2 fade-in">
        <slot/>
    </ul>
</div>