---
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Redirecting...</title>
    <style is:inline>
        body {
            background-color: rgba(50, 37, 80, 0.57); /* <-- CHANGE THIS to your site's background color */
            font-family: sans-serif;
            color: #676767;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            margin: 0;
        }
    </style>

    <script is:inline>
        const supportedLangs = ['en','fr'];
        const defaultLang = 'en';
        const userLang = navigator.language.split('-')[0];
        let targetLang = defaultLang;
        if (supportedLangs.includes(userLang)) {
            targetLang = userLang;
        }
        const redirectTo = `${window.location.origin}${window.location.pathname.replace(/\/$/, '')}/${targetLang}/`;
        window.location.replace(redirectTo);
    </script>
</head>
<body>
<p>
    Redirecting to your preferred language...<br><br>
    <a href="/en/" style="color: white;">Continue in English</a> |
    <a href="/fr/" style="color: white;">Continuer en français</a>
</p>
</body>
</html>