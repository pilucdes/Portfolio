---
import Layout from "../../layouts/Layout.astro";
import IconListItem from "../../components/IconListItem.astro";
import ExpertiseCard from "../../components/cards/ExpertiseCard.astro";
import ProjectCard from "../../components/cards/ProjectCard.astro";
import HeroSection from "../../components/sections/HeroSection.astro";
import PageSection from "../../components/sections/PageSection.astro";
import {Icon} from 'astro-icon/components';
import Nav from "../../components/Nav.astro";

import {useTranslations, getLangFromUrl} from "../../scripts/services/i18nService";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

export function getStaticPaths() {
    return [
        {params: {lang: 'en'}},
        {params: {lang: 'fr'}},
    ];
}
---
<Layout>

    <Nav/>

    <div class="container mx-auto">

        <HeroSection/>

        <PageSection title={t("section.about.title")} class="text-center md:text-start text-xl lg:text-3xl whitespace-pre-line">
            <p class="delay-100 fade-in">{t("section.about.description1")}</p>
            <p class="delay-200 fade-in">{t("section.about.description2")}</p>
            <p class="delay-300 fade-in">{t("section.about.description3")}</p>
        </PageSection>

        <PageSection id="skills" title={t("section.expertise.title")}>
            <div class="grid grid-cols-[repeat(auto-fit,minmax(250px,1fr))] gap-10 ">

                <ExpertiseCard title={t("section.expertise.proficient")} class="delay-100">
                    <IconListItem text="C#" iconName="devicon:csharp"/>
                    <IconListItem text="Blazor" iconName="devicon:blazor"/>
                    <IconListItem text="Entity Framework" iconName="devicon:dot-net"/>
                    <IconListItem text="MSSQL" iconName="devicon:microsoftsqlserver"/>
                    <IconListItem text="MongoDB" iconName="devicon:mongodb"/>
                    <IconListItem text="Azure" iconName="devicon:azure"/>
                    <IconListItem text="Docker" iconName="devicon:docker"/>
                </ExpertiseCard>

                <ExpertiseCard title={t("section.expertise.familiarwith")} class="delay-200">
                    <IconListItem text="Tailwind CSS" iconName="devicon:tailwindcss"/>
                    <IconListItem text="Angular 2" iconName="devicon:angular"/>
                    <IconListItem text="React" iconName="devicon:react"/>
                    <IconListItem text="Vue.js" iconName="devicon:vuejs"/>
                    <IconListItem text="Astro" iconName="devicon-plain:astro"/>
                    <IconListItem text="Node.js" iconName="devicon:nodejs"/>
                    <IconListItem text="AWS" iconName="devicon-plain:amazonwebservices-wordmark"/>
                    <IconListItem text="PostgreSQL" iconName="devicon:postgresql"/>
                </ExpertiseCard>

            </div>
        </PageSection>

        <PageSection id="projects" title={t("section.featuredprojects.title")}>
            <ProjectCard
                    href="https://github.com/pilouk/SnapToTable"
                    imageUrl="https://storage.googleapis.com/cms-bgrem-deelvin-com/food_a691d3b07f/food_a691d3b07f.jpg"
                    title={t("project.snap.title")}
                    description={t("project.snap.description")}>

                <ul slot="technologies">
                    <IconListItem text="C#" iconName="devicon:csharp"/>
                    <IconListItem text="MongoDB" iconName="devicon:mongodb"/>
                    <IconListItem text="React Native" iconName="devicon:react"/>
                </ul>
            </ProjectCard>
        </PageSection>

        <PageSection id="connect" title={t("section.connect.title")}>
            <div class="flex flex-row gap-12 justify-center items-center text-5xl lg:text-7xl connect-item fade-in">
                <a href="https://www.linkedin.com/in/pierre-luc-deschesnes-467193144/" class="link-item"
                   aria-label="Pierre-luc linkedin" target="_blank" rel="noopener noreferrer">
                    <Icon name="devicon-plain:linkedin"/>
                </a>
                <a href="mailto:pilucdes@gmail.com" aria-label="Email me" class="link-item">
                    <Icon name="mdi:email-outline"/>
                </a>
            </div>
        </PageSection>

    </div>
</Layout>